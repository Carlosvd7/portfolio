---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { getLang, useT, homePath, htmlLang, ogLocale, otherLang, type Lang } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas sin traducción (404) no emiten hreflang ni se indexan. */
  alternates?: boolean;
  noindex?: boolean;
}

const lang: Lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { title = t.meta.title, description = t.meta.description, alternates = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = (l: Lang) => new URL(homePath(l), Astro.site).href;
const ogImage = new URL(`/og/${lang}.png`, Astro.site).href;

/** Enlaces aún sin rellenar (p. ej. LinkedIn) no se publican en sameAs. */
const isReal = (url: string) => !/linkedin\.com\/in\/?$/.test(url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${alt('es')}#person`,
  name: site.name,
  alternateName: site.shortName,
  givenName: 'Carlos Manuel',
  familyName: 'Velázquez Diego',
  jobTitle: site.role,
  description: t.meta.description,
  url: alt(lang),
  image: ogImage,
  email: `mailto:${site.email}`,
  sameAs: [site.links.linkedin, site.links.github].filter(isReal),
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Universidad Pontificia de Salamanca',
      url: 'https://www.upsa.es',
    },
  ],
  knowsAbout: ['Machine Learning', 'Generative AI', 'Data Science', 'Python', 'TensorFlow', 'SQL', 'TypeScript', 'Power Platform'],
  knowsLanguage: ['es', 'en'],
};
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="es" href={alt('es')} />
          <link rel="alternate" hreflang="en" href={alt('en')} />
          <link rel="alternate" hreflang="x-default" href={alt('es')} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    <meta property="profile:first_name" content="Carlos Manuel" />
    <meta property="profile:last_name" content="Velázquez Diego" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    <meta name="author" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="theme-color" content="#09090D" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/brands.css" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.a11y.skip}</a>

    <div class="site-bg" aria-hidden="true">
      <span class="site-bg__glow site-bg__glow--violet"></span>
      <span class="site-bg__glow site-bg__glow--amber"></span>
    </div>

    <Header lang={lang} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <CommandPalette lang={lang} />
  </body>
</html>

<script>
  import '../scripts/main';
</script>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-btn);
    background: var(--accent);
    color: #1a1204;
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
    outline-color: var(--text-strong);
  }
  main:focus {
    outline: none;
  }
</style>
