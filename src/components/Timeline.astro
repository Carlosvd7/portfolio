---
/**
 * Línea de tiempo de experiencia y formación (ordenadas por `order`).
 * La línea vertical se rellena con el scroll (scripts/timeline.ts) y cada nodo se ilumina.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import TechChip from './TechChip.astro';
import { useT, type Lang } from '../i18n/utils';
import { rich, formatYM } from '../i18n/format';
import type { TechId } from '../data/tech';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

interface Entry {
  key: string;
  order: number;
  title: string;
  org: string;
  initials: string;
  logo?: ImageMetadata;
  url?: string;
  location?: string;
  start: string;
  end?: string;
  upcoming: boolean;
  kind: 'work' | 'edu';
  bullets: string[];
  description?: string;
  tech: TechId[];
}

const [experience, education] = await Promise.all([getCollection('experience'), getCollection('education')]);

const entries: Entry[] = [
  ...experience.map(({ id, data }) => ({
    key: id,
    order: data.order,
    title: data.role[lang],
    org: data.company,
    initials: data.initials,
    logo: data.logo,
    url: data.url,
    location: data.location,
    start: data.start,
    end: data.end,
    upcoming: false,
    kind: 'work' as const,
    bullets: data.bullets[lang],
    tech: data.tech,
  })),
  ...education.map(({ id, data }) => ({
    key: id,
    order: data.order,
    title: data.title[lang],
    org: data.institution,
    initials: data.initials,
    logo: data.logo,
    url: data.url,
    location: data.location,
    start: data.start,
    end: data.end,
    upcoming: data.upcoming,
    kind: 'edu' as const,
    bullets: data.bullets?.[lang] ?? [],
    description: data.description?.[lang],
    tech: data.tech,
  })),
].sort((a, b) => a.order - b.order);

const dateLabel = (e: Entry) =>
  e.end ? `${formatYM(e.start, lang)} — ${formatYM(e.end, lang)}` : `${t.timeline.since} ${formatYM(e.start, lang)}`;
---

<div class="timeline" data-timeline>
  <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill" data-timeline-fill></span></span>
  <ol class="timeline__list">
  {
    entries.map((e) => (
      <li class:list={['tl-item', { 'is-upcoming': e.upcoming }]} data-reveal data-tl-item>
        <span class="tl-item__node" aria-hidden="true" data-tl-node />
        <p class="tl-item__date font-tech">
          <time datetime={e.start}>{dateLabel(e)}</time>
        </p>

        <article class="tl-card card" data-spotlight>
          <header class="tl-card__head">
            <span class="tl-card__logo" aria-hidden={e.logo ? undefined : 'true'}>
              {e.logo ? (
                <Image src={e.logo} alt={`${t.timeline.logoOf} ${e.org}`} width={40} height={40} />
              ) : (
                <span class="font-tech">{e.initials}</span>
              )}
            </span>
            <div class="tl-card__titles">
              <h3 class="tl-card__title">{e.title}</h3>
              <p class="tl-card__org">
                {e.url ? (
                  <a href={e.url} target="_blank" rel="noopener noreferrer">
                    {e.org}
                    <span class="sr-only">{t.a11y.newTab}</span>
                  </a>
                ) : (
                  e.org
                )}
                {e.location && (
                  <span class="tl-card__loc">
                    <Icon name="lucide:map-pin" aria-hidden="true" />
                    {e.location}
                  </span>
                )}
              </p>
            </div>
            {e.upcoming ? (
              <span class="badge badge--violet font-tech">
                <Icon name="lucide:calendar-clock" aria-hidden="true" />
                {t.timeline.upcoming}
              </span>
            ) : (
              <span class="tl-card__kind" aria-hidden="true">
                <Icon name={e.kind === 'work' ? 'lucide:briefcase' : 'lucide:graduation-cap'} />
              </span>
            )}
          </header>

          {e.bullets.length > 0 && (
            <ul class="tl-card__bullets">
              {e.bullets.map((b) => (
                <li set:html={rich(b)} />
              ))}
            </ul>
          )}
          {e.description && <p class="tl-card__desc" set:html={rich(e.description)} />}

          {e.tech.length > 0 && (
            <ul class="tl-card__chips" role="list">
              {e.tech.map((id) => (
                <li>
                  <TechChip name={id} />
                </li>
              ))}
            </ul>
          )}
        </article>
      </li>
    ))
  }
  </ol>
</div>

<style>
  .timeline {
    --rail-x: 7px;
    position: relative;
    padding-left: 2rem;
  }
  .timeline__list {
    display: grid;
    gap: 1.75rem;
  }
  @media (width >= 860px) {
    .timeline {
      --rail-x: 187px;
      padding-left: 0;
    }
  }

  .timeline__rail {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: var(--rail-x);
    width: 2px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    transform-origin: top;
    transform: scaleY(var(--progress, 1));
  }

  .tl-item {
    position: relative;
    display: grid;
    gap: 0.6rem;
  }
  @media (width >= 860px) {
    .tl-item {
      grid-template-columns: 160px 1fr;
      gap: 3.5rem;
    }
  }

  .tl-item__node {
    position: absolute;
    top: 6px;
    left: calc(var(--rail-x) - 2rem - 5px);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent),
      0 0 16px 2px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  @media (width >= 860px) {
    .tl-item__node {
      top: 1.6rem;
      left: calc(var(--rail-x) - 5px);
    }
  }
  .tl-item.is-upcoming .tl-item__node {
    border-color: var(--accent-2);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent-2) 14%, transparent),
      0 0 16px 2px color-mix(in srgb, var(--accent-2) 55%, transparent);
  }
  .tl-item__node {
    transition:
      border-color 400ms var(--ease-out-expo),
      box-shadow 400ms var(--ease-out-expo),
      transform 400ms var(--ease-out-expo);
  }
  /* Con JS, el nodo se enciende cuando la línea llega a él */
  @media (scripting: enabled) {
    .tl-item:not(.is-lit) .tl-item__node {
      border-color: var(--border-strong);
      box-shadow: none;
      transform: scale(0.85);
    }
    .timeline__fill {
      transform: scaleY(var(--progress, 0));
    }
  }

  .tl-item__date {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }
  @media (width >= 860px) {
    .tl-item__date {
      padding-top: 1.35rem;
      text-align: right;
    }
  }

  .tl-card {
    padding: 1.4rem 1.4rem 1.5rem;
    transition: border-color var(--dur-base) var(--ease-out-expo);
  }
  .tl-card:hover {
    border-color: var(--border-strong);
  }
  .tl-item.is-upcoming .tl-card {
    border-style: dashed;
  }

  .tl-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .tl-card__logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(145deg, var(--surface-2), var(--bg));
    color: var(--text-strong);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .tl-card__titles {
    flex: 1;
    min-width: 0;
  }
  .tl-card__title {
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .tl-card__org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--accent);
  }
  .tl-card__org a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast);
  }
  .tl-card__org a:hover {
    text-decoration-color: var(--accent);
  }
  .tl-card__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 400;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .tl-card__loc svg {
    width: 14px;
    height: 14px;
  }
  .tl-card__kind {
    color: var(--subtle);
  }
  .tl-card__kind svg {
    width: 18px;
    height: 18px;
  }

  .tl-card__bullets {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
  }
  .tl-card__bullets li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .tl-card__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent-2);
    transform: rotate(45deg);
  }
  .tl-card__desc {
    margin-top: 1rem;
    color: var(--muted);
  }
  .tl-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.2rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .badge svg {
    width: 13px;
    height: 13px;
  }
  .badge--violet {
    color: #c4bbff;
    background: color-mix(in srgb, var(--accent-2) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 40%, transparent);
  }

  @media (width < 480px) {
    .tl-card {
      padding: 1.15rem;
    }
    .tl-card__head {
      flex-wrap: wrap;
    }
    .tl-card__titles {
      flex-basis: calc(100% - 40px - 0.9rem);
    }
    .badge {
      order: 3;
      margin-left: calc(40px + 0.9rem);
    }
    .tl-card__kind {
      display: none;
    }
  }
</style>
