---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import TechChip from './TechChip.astro';
import { useT, type Lang } from '../i18n/utils';

interface Props {
  group: CollectionEntry<'stack'>;
  index: number;
  lang: Lang;
}

const { group, index, lang } = Astro.props;
const { data } = group;
const t = useT(lang);
const titleId = `stack-${group.id}`;
const count = t.stack.techCount.replace('{n}', String(data.items.length));
---

{
  data.learning ? (
    <section class="learning" aria-labelledby={titleId} data-reveal>
      <h3 id={titleId} class="learning__title">
        <Icon name={data.icon} aria-hidden="true" />
        {data.title[lang]}
      </h3>
      <ul class="learning__list" role="list">
        {data.items.map((id) => (
          <li>
            <TechChip name={id} />
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="sgroup card" aria-labelledby={titleId} data-reveal data-spotlight>
      <header class="sgroup__head">
        <span class="sgroup__icon" aria-hidden="true">
          <Icon name={data.icon} />
        </span>
        <div class="sgroup__titles">
          <p class="sgroup__num font-tech" aria-hidden="true">
            {String(index).padStart(2, '0')}
          </p>
          <h3 id={titleId} class="sgroup__title">
            {data.title[lang]}
          </h3>
        </div>
        <p class="sgroup__count font-tech">{count}</p>
      </header>
      <ul class="sgroup__grid" role="list">
        {data.items.map((id) => (
          <li>
            <TechChip name={id} variant="tile" />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .sgroup {
    padding: 1.4rem 1.25rem 1.1rem;
    transition: border-color var(--dur-base) var(--ease-out-expo);
  }
  .sgroup:hover {
    border-color: var(--border-strong);
  }
  .sgroup__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 0.25rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .sgroup__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .sgroup:hover .sgroup__icon {
    transform: rotate(-6deg) scale(1.05);
  }
  .sgroup__icon svg {
    width: 20px;
    height: 20px;
  }
  .sgroup__titles {
    flex: 1;
    min-width: 0;
  }
  .sgroup__num {
    font-size: 0.72rem;
    color: var(--accent-2);
    line-height: 1.2;
  }
  .sgroup__title {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .sgroup__count {
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .sgroup__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(78px, 1fr));
    gap: 0.25rem;
    padding-top: 1rem;
  }

  .learning {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
    padding: 1.1rem 1.35rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-card-sm);
    background: color-mix(in srgb, var(--surface) 50%, transparent);
  }
  .learning__title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ok);
  }
  .learning__title svg {
    width: 17px;
    height: 17px;
  }
  .learning__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
