---
/**
 * Tecnología con su logo. Lee icono, color y nombre de `src/data/tech.ts`.
 *  - variant="chip": icono + nombre (líneas de tiempo, proyectos).
 *    En reposo monocromo; con hover toma su color de marca, se eleva y brilla.
 *  - variant="tile": logo oficial a color en un tile teñido con la marca (rejilla del stack).
 *    Tooltip con el nombre; enfocable con teclado; en táctil el nombre va siempre debajo.
 */
import { Icon } from 'astro-icon/components';
import { getTech, type TechId } from '../data/tech';

interface Props {
  name: TechId;
  variant?: 'chip' | 'tile';
  class?: string;
}

const { name, variant = 'chip', class: className } = Astro.props;
const tech = getTech(name);
---

{
  variant === 'chip' ? (
    <span class:list={['tech-chip', className]} data-brand={name}>
      <Icon name={tech.icon} aria-hidden="true" />
      <span>{tech.label}</span>
    </span>
  ) : (
    <span class:list={['tech-tile', className]} data-brand={name} tabindex="0" role="img" aria-label={tech.label}>
      <span class="tech-tile__box" aria-hidden="true">
        <Icon name={tech.logo ?? tech.icon} />
      </span>
      <span class="tech-tile__name" aria-hidden="true">
        {tech.label}
      </span>
      <span class="tech-tile__tip font-tech" aria-hidden="true">
        {tech.label}
      </span>
    </span>
  )
}

<style>
  /* ---------- Chip ---------- */
  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--muted);
    transition:
      color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo);
  }
  .tech-chip svg {
    width: 14px;
    height: 14px;
    transition:
      color var(--dur-fast) var(--ease-out-expo),
      filter var(--dur-base) var(--ease-out-expo);
  }
  .tech-chip:hover {
    color: var(--text-strong);
    border-color: color-mix(in srgb, var(--brand) 45%, var(--border));
    transform: translateY(-2px);
  }
  .tech-chip:hover svg {
    color: var(--brand);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--brand) 60%, transparent));
  }

  /* ---------- Tile ---------- */
  /* Tile estilo "app icon": cuadrado teñido con el color de la marca, logo a color
     y un halo suave del mismo tono. Con hover/foco se eleva y el halo crece. */
  .tech-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border-radius: 18px;
    color: var(--brand);
    cursor: default;
    outline-offset: 4px;
  }
  .tech-tile__box {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--brand) 24%, transparent);
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.06), transparent 55%),
      color-mix(in srgb, var(--brand) 13%, var(--surface-2));
    box-shadow:
      0 10px 28px -14px color-mix(in srgb, var(--brand) 70%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      box-shadow var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      background-color var(--dur-fast) var(--ease-out-expo);
  }
  .tech-tile__box svg {
    width: 32px;
    height: 32px;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .tech-tile:hover .tech-tile__box,
  .tech-tile:focus-visible .tech-tile__box {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--brand) 50%, transparent);
    box-shadow:
      0 16px 36px -12px color-mix(in srgb, var(--brand) 85%, transparent),
      0 0 0 1px color-mix(in srgb, var(--brand) 20%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
  }
  .tech-tile:hover .tech-tile__box svg,
  .tech-tile:focus-visible .tech-tile__box svg {
    transform: scale(1.08);
  }
  .tech-tile__name {
    max-width: 84px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.2;
    text-align: center;
    color: var(--muted);
  }
  .tech-tile__tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    z-index: 5;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--text-strong);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-fast) var(--ease-out-expo);
  }
  .tech-tile:hover .tech-tile__tip,
  .tech-tile:focus-visible .tech-tile__tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Con ratón: logo limpio y nombre en tooltip. En táctil: nombre siempre visible. */
  @media (hover: hover) and (pointer: fine) {
    .tech-tile__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (hover: none) {
    .tech-tile__tip {
      display: none;
    }
  }
</style>
