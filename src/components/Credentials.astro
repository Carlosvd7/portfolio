---
/**
 * Carrusel de credenciales: scroll-snap nativo (táctil, trackpad, rueda con Shift),
 * botones anterior/siguiente y barra de progreso (scripts/carousel.ts).
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CredentialCard from './CredentialCard.astro';
import { useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  labelledBy: string;
}

const { lang, labelledBy } = Astro.props;
const t = useT(lang);
const credentials = (await getCollection('credentials', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<div class="carousel" data-carousel role="region" aria-roledescription={t.credentials.carousel} aria-labelledby={labelledBy} data-reveal>
  <!-- tabindex: la zona desplazable debe poder recorrerse con el teclado (← →) -->
  <div class="carousel__track" data-carousel-track role="group" tabindex="0" aria-label={t.credentials.trackLabel}>
    {credentials.map((c, i) => <CredentialCard credential={c} lang={lang} index={i + 1} total={credentials.length} />)}
  </div>

  <div class="carousel__controls">
    <div class="carousel__progress" aria-hidden="true"><span data-carousel-bar></span></div>
    <button type="button" class="carousel__btn" data-carousel-prev aria-label={t.credentials.prev} disabled>
      <Icon name="lucide:arrow-left" aria-hidden="true" />
    </button>
    <button type="button" class="carousel__btn" data-carousel-next aria-label={t.credentials.next}>
      <Icon name="lucide:arrow-right" aria-hidden="true" />
    </button>
  </div>
</div>

<style>
  .carousel {
    position: relative;
  }
  .carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding: 0.5rem 0 1.25rem;
    scrollbar-width: none;
    /* Las diapositivas se desvanecen hacia el borde derecho */
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel[data-at-end] .carousel__track {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%);
    mask-image: linear-gradient(90deg, transparent, #000 15%);
  }
  .carousel__track > :global(:last-child) {
    margin-right: 2rem;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .carousel__progress {
    flex: 1;
    height: 2px;
    margin-right: 0.6rem;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .carousel__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: left;
    transform: scaleX(var(--p, 0.2));
    transition: transform 300ms var(--ease-out-expo);
  }
  .carousel__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      opacity var(--dur-fast);
  }
  .carousel__btn svg {
    width: 18px;
    height: 18px;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .carousel__btn:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--accent-2) 60%, var(--border-strong));
    background: var(--surface-2);
    transform: translateY(-1px);
  }
  .carousel__btn[data-carousel-next]:hover:not(:disabled) svg {
    transform: translateX(2px);
  }
  .carousel__btn[data-carousel-prev]:hover:not(:disabled) svg {
    transform: translateX(-2px);
  }
  .carousel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>
