---
import { Icon } from 'astro-icon/components';
import { metrics } from '../data/metrics';
import { useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section class="container-x metrics-section" aria-labelledby="metrics-title">
  <h2 id="metrics-title" class="sr-only">{t.metrics.title}</h2>
  <ul class="metrics" role="list">
    {
      metrics.map((m) => (
        <li class="metric card" data-reveal data-spotlight>
          <span class="metric__icon" aria-hidden="true">
            <Icon name={m.icon} />
          </span>
          <p class="metric__value">
            <span class="sr-only">{`${m.prefix ?? ''}${m.value}${m.suffix ?? ''}`}</span>
            <span aria-hidden="true">{m.prefix}<span data-count={m.value}>{m.value}</span>{m.suffix}</span>
          </p>
          <p class="metric__text">{m.text[lang]}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .metrics-section {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .metrics {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  @media (width >= 1024px) {
    .metrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .metric {
    padding: 1.4rem 1.35rem 1.5rem;
    border-radius: var(--radius-card-sm);
    transition:
      border-color var(--dur-base) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo);
  }
  .metric:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .metric__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent-2) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
    color: var(--accent-2);
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .metric:hover .metric__icon {
    transform: translateY(-2px) rotate(-6deg);
  }
  .metric__icon svg {
    width: 20px;
    height: 20px;
  }
  .metric__value {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 2.9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .metric__text {
    margin-top: 0.6rem;
    font-size: 0.93rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
