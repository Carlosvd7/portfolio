---
/**
 * Diapositiva del carrusel de credenciales.
 * Arriba la insignia/certificado (o el logo del emisor si aún no hay imagen); abajo los datos.
 */
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getTech } from '../data/tech';
import { useT, type Lang } from '../i18n/utils';
import { formatYM } from '../i18n/format';

interface Props {
  credential: CollectionEntry<'credentials'>;
  lang: Lang;
  index: number;
  total: number;
}

const { credential, lang, index, total } = Astro.props;
const { data } = credential;
const t = useT(lang);
const issuer = getTech(data.issuer);
const isLanguage = data.kind === 'language';
const issuerLabel = isLanguage ? t.credentials.languages : data.issuerName;
const name = data.name[lang];
---

<div
  class="slide"
  data-brand={data.issuer}
  data-slide
  role="group"
  aria-roledescription={t.credentials.slide}
  aria-label={`${index} / ${total}: ${name}`}
>
  <div class="slide__media">
    {
      data.image ? (
        <Image src={data.image} alt={`${t.credentials.badgeOf} ${name}`} width={520} loading="lazy" decoding="async" />
      ) : (
        <span class="slide__logo" aria-hidden="true">
          <Icon name={issuer.logo ?? issuer.icon} />
        </span>
      )
    }
    <span class="slide__count font-tech" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  </div>

  <div class="slide__body">
    <p class="slide__issuer font-tech">
      <Icon name={issuer.icon} aria-hidden="true" />
      <span>{[issuerLabel, data.date && formatYM(data.date, lang)].filter(Boolean).join(' · ')}</span>
    </p>
    <h3 class="slide__name">{name}</h3>
    {data.note && <p class="slide__note">{data.note[lang]}</p>}
    {
      data.verifyUrl && (
        <a href={data.verifyUrl} class="slide__verify" target="_blank" rel="noopener noreferrer">
          <Icon name="lucide:shield-check" aria-hidden="true" />
          {t.credentials.verify}
          <Icon name="lucide:arrow-up-right" aria-hidden="true" class="slide__arrow" />
          <span class="sr-only">
            {name} {t.a11y.newTab}
          </span>
        </a>
      )
    }
  </div>
</div>

<style>
  @property --cred-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .slide {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: min(320px, 82vw);
    scroll-snap-align: start;
    padding: 1px;
    border-radius: var(--radius-card);
    background: var(--border);
    isolation: isolate;
  }
  /* Borde con gradiente cónico animado (ámbar → violeta) al hacer hover o foco */
  .slide::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(from var(--cred-angle), var(--accent), var(--accent-2), transparent 40%, transparent 60%, var(--accent-2), var(--accent));
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-expo);
  }
  .slide:hover::before,
  .slide:focus-within::before {
    opacity: 1;
    animation: cred-spin 3s linear infinite;
  }
  @keyframes cred-spin {
    to {
      --cred-angle: 360deg;
    }
  }

  .slide__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px) 0 0;
    background:
      radial-gradient(circle at 50% 60%, color-mix(in srgb, var(--brand) 20%, transparent), transparent 58%),
      radial-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(160deg, var(--surface-2), var(--bg));
  }
  .slide__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    object-fit: contain;
    filter: drop-shadow(0 14px 24px rgb(0 0 0 / 0.5));
    transition: transform 600ms var(--ease-out-expo);
  }
  .slide:hover .slide__media :global(img) {
    transform: scale(1.04) rotate(-1deg);
  }
  .slide__logo {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 26px;
    border: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), transparent 55%), color-mix(in srgb, var(--brand) 14%, var(--surface-2));
    color: var(--brand);
    box-shadow: 0 18px 40px -16px color-mix(in srgb, var(--brand) 80%, transparent);
    transition: transform 600ms var(--ease-out-expo);
  }
  .slide:hover .slide__logo {
    transform: translateY(-4px) rotate(-4deg);
  }
  .slide__logo svg {
    width: 44px;
    height: 44px;
  }
  .slide__count {
    position: absolute;
    top: 0.8rem;
    left: 0.9rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .slide__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.2rem 1.25rem;
    border-radius: 0 0 calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px);
    background: var(--surface);
  }
  .slide__issuer {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .slide__issuer svg {
    width: 14px;
    height: 14px;
    color: var(--brand);
  }
  .slide__name {
    margin-top: 0.5rem;
    font-size: 1.12rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .slide__note {
    margin-top: 0.35rem;
    font-size: 0.86rem;
    color: var(--accent);
  }
  .slide__verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    min-height: 44px;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-strong);
    transition: color var(--dur-fast);
  }
  .slide__verify svg {
    width: 15px;
    height: 15px;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .slide__verify:hover {
    color: var(--accent);
  }
  .slide__verify:hover .slide__arrow {
    transform: translate(2px, -2px);
  }
</style>
