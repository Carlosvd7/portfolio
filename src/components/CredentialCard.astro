---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getTech } from '../data/tech';
import { useT, type Lang } from '../i18n/utils';
import { formatYM } from '../i18n/format';

interface Props {
  credential: CollectionEntry<'credentials'>;
  lang: Lang;
}

const { credential, lang } = Astro.props;
const { data } = credential;
const t = useT(lang);
const issuer = getTech(data.issuer);
const isLanguage = data.kind === 'language';
const meta = [isLanguage ? t.credentials.languages : data.issuerName, data.date && formatYM(data.date, lang)]
  .filter(Boolean)
  .join(' · ');
---

<li class="cred" data-brand={data.issuer} data-reveal>
  <div class="cred__inner">
    <span class="cred__logo" aria-hidden="true">
      <Icon name={issuer.icon} />
    </span>
    <div class="cred__body">
      <h3 class="cred__name">{data.name[lang]}</h3>
      <p class="cred__meta font-tech">{meta}</p>
      {data.note && <p class="cred__note">{data.note[lang]}</p>}
      {
        data.verifyUrl && (
          <a href={data.verifyUrl} class="cred__verify" target="_blank" rel="noopener noreferrer">
            <Icon name="lucide:shield-check" aria-hidden="true" />
            {t.credentials.verify}
            <Icon name="lucide:arrow-up-right" aria-hidden="true" class="cred__arrow" />
            <span class="sr-only">
              {data.name[lang]} {t.a11y.newTab}
            </span>
          </a>
        )
      }
    </div>
  </div>
</li>

<style>
  @property --cred-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .cred {
    position: relative;
    padding: 1px;
    border-radius: var(--radius-card-sm);
    background: var(--border);
    isolation: isolate;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  /* Borde con gradiente cónico animado al hacer hover */
  .cred::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(
      from var(--cred-angle),
      var(--accent),
      var(--accent-2),
      transparent 40%,
      transparent 60%,
      var(--accent-2),
      var(--accent)
    );
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-expo);
  }
  .cred:hover,
  .cred:focus-within {
    transform: translateY(-2px);
  }
  .cred:hover::before,
  .cred:focus-within::before {
    opacity: 1;
    animation: cred-spin 3s linear infinite;
  }
  @keyframes cred-spin {
    to {
      --cred-angle: 360deg;
    }
  }

  .cred__inner {
    display: flex;
    gap: 0.95rem;
    height: 100%;
    padding: 1.15rem 1.15rem 1.2rem;
    border-radius: calc(var(--radius-card-sm) - 1px);
    background: var(--surface);
  }
  .cred__logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--muted);
    transition:
      color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast);
  }
  .cred__logo svg {
    width: 21px;
    height: 21px;
    transition: filter var(--dur-base) var(--ease-out-expo);
  }
  .cred:hover .cred__logo {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 40%, var(--border-strong));
  }
  .cred:hover .cred__logo svg {
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--brand) 55%, transparent));
  }
  .cred__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cred__name {
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .cred__meta {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .cred__note {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .cred__verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 0.2rem;
    margin-bottom: -0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-strong);
    transition: color var(--dur-fast);
  }
  .cred__verify svg {
    width: 15px;
    height: 15px;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .cred__verify:hover {
    color: var(--accent);
  }
  .cred__verify:hover .cred__arrow {
    transform: translate(2px, -2px);
  }
</style>
